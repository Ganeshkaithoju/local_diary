{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Diary Core",
  "version": "1.1.2",
  "identifier": "com.mydiary.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Local Diary Core",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": null,
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    }
  },
  "plugins": {
    "opener": {},
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ1NTkyNjM0NTMzQzlGMTIKUldRU256eFROQ1paUmZoeURTanZJWGZ4TC9vTU9kZzQzQkcvQ25jdXhDRU54MDJWdTVaQUVzVE8K",
      "endpoints": [
        "https://github.com/Ganeshkaithoju/local_diary/releases/latest/download/latest.json",
        "https://github.com/Ganeshkaithoju/local-diary-core/releases/latest/download/latest.json"
      ]
    }
  }
}
